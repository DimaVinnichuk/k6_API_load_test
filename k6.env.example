# --- API ENDPOINT CONFIGURATION ---
# BASE_URL: The base URL of the API endpoint being tested (e.g., https://api.myproject.com).
BASE_URL=

# USERNAME: The username required for the login API call.
USERNAME=

# PASSWORD: The password required for the login API call.
PASSWORD=

# LOGIN_PATH: The API endpoint path for login
LOGIN_PATH=

# API_PATHS: Comma-separated list of API endpoints to test (no spaces between paths!)
API_PATHS=

# LOGO_ID: Custom header required by the API
LOGO_ID=


# --- K6 LOAD TEST CONFIGURATION (Ramping VUs Scenario) ---
# PEAK_VUS: The maximum number of virtual users (VUs) the test will reach during the peak phase.
PEAK_VUS=100

# DURATION_PEAK: The duration for which the test will maintain the PEAK_VUS load.
DURATION_PEAK=5m

# DURATION_RAMP: The duration of the ramp-up (and ramp-down) phase.
DURATION_RAMP=1m


# --- K6 WEB DASHBOARD CONFIGURATION (Optional) ---
# K6_WEB_DASHBOARD: Set to 'true' to enable the built-in web dashboard (accessible via port 5665).
K6_WEB_DASHBOARD=true

# K6_WEB_DASHBOARD_EXPORT: The filename for the HTML report generated after the test run.
K6_WEB_DASHBOARD_EXPORT=k6_report.html